{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "structural-only schema. Operational validity is defined exclusively by scripts/customer-ops.py validate(); schema acceptance must not be treated as permission to mutate inventory, secrets, or monitoring targets.",
  "title": "KimKom customer inventory (structural contract only)",
  "type": "object",
  "required": ["schema_version", "customers"],
  "properties": {
    "schema_version": {"const": 1},
    "customers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/customer"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "customer": {
      "type": "object",
      "required": ["slug", "name", "status", "glitchtip", "portainer"],
      "properties": {
        "slug": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["reserved", "active", "suspended"]},
        "domain": {"type": "string"},
        "glitchtip": {
          "type": "object",
          "required": ["project_slug", "dsn_ref"],
          "properties": {
            "project_slug": {"type": "string", "minLength": 1},
            "dsn_ref": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "portainer": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["pending", "accepted"]},
            "endpoint_ref": {"type": "string"}
          },
          "additionalProperties": true
        },
        "development": {"$ref": "#/$defs/environment"},
        "production": {"$ref": "#/$defs/environment"}
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["active"],
      "properties": {
        "active": {"type": "boolean"},
        "management_target": {"type": "string"},
        "node_target": {"type": "string"},
        "postgres_target": {"type": "string"},
        "http_target": {"type": "string"},
        "https_target": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
