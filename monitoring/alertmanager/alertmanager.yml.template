global:
  resolve_timeout: 5m

route:
  receiver: "telegram"
  group_by: ["client", "environment", "alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Pilot alerts: catch and discard regardless of severity.
    # Production targets use environment="production"; pilot/lab
    # should never reach the pager.
    - matchers:
        - environment != "production"
      receiver: "mute"
    - matchers:
        - severity = "critical"
      receiver: "telegram"
      continue: true

receivers:
  - name: "mute"
  - name: "telegram"
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: 0
        send_resolved: true
        api_url: "https://api.telegram.org"
        message: '{{ .CommonLabels.alertname }}: {{ .CommonAnnotations.summary }}'
