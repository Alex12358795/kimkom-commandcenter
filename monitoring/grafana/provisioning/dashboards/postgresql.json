{
  "uid": "kimkom-postgresql",
  "title": "PostgreSQL \u2013 CommandCenter Shared",
  "tags": [
    "postgresql",
    "kimkom"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(pg_up, instance)",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL Up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_up{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{instance=~\"$instance\",datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transaction Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m]) + rate(pg_stat_database_xact_rollback{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m])",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 4,
      "title": "Tuples Fetched / Returned / Inserted",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m])",
          "legendFormat": "{{datname}} fetched"
        },
        {
          "expr": "rate(pg_stat_database_tup_returned{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m])",
          "legendFormat": "{{datname}} returned"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m])",
          "legendFormat": "{{datname}} inserted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 5,
      "title": "Database Size",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{instance=~\"$instance\",datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m]) / (rate(pg_stat_database_blks_hit{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m]) + rate(pg_stat_database_blks_read{instance=~\"$instance\",datname!~\"template.*|postgres\"}[2m])) * 100",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    }
  ]
}