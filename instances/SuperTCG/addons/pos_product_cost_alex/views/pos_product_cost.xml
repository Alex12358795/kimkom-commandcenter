<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_product_form_add_cost" model="ir.ui.view">
        <field name="name">POS create product – add cost</field>
        <field name="model">product.product</field>
        <!--  the exact external ID from your database  -->
        <field name="inherit_id" ref="point_of_sale.product_product_view_form_normalized_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="standard_price" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
