<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Odoo Home (root app view)                    -->
    <!-- ============================================ -->

    <record id="action_odoo_home" model="ir.actions.act_url">
        <field name="name">Odoo Home</field>
        <field name="url">/odoo</field>
        <field name="target">self</field>
    </record>

    <!-- ============================================ -->
    <!-- SuperTCG Hub (single app)                    -->
    <!-- ============================================ -->

    <record id="action_tcg_hub_dashboard" model="ir.actions.act_url">
        <field name="name">SuperTCG Hub</field>
        <field name="url">/tcg/hub</field>
        <field name="target">self</field>
    </record>

    <record id="action_tcg_card_form" model="ir.actions.client">
        <field name="name">Add TCG Card</field>
        <field name="tag">tcg_card_form</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="action_tcg_ocr_card_form" model="ir.actions.client">
        <field name="name">Add TCG Card (OCR)</field>
        <field name="tag">tcg_ocr_card_form</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="action_tcg_aankoop_dashboard" model="ir.actions.act_url">
        <field name="name">Aankoop Dashboard</field>
        <field name="url">/tcg/aankoop</field>
        <field name="target">self</field>
    </record>

    <record id="action_tcg_consignment_dashboard" model="ir.actions.act_url">
        <field name="name">Consignment Dashboard</field>
        <field name="url">/tcg/consignment</field>
        <field name="target">self</field>
    </record>

    <record id="action_tcg_margin_dashboard" model="ir.actions.act_url">
        <field name="name">Margin Dashboard</field>
        <field name="url">/tcg/margin</field>
        <field name="target">self</field>
    </record>

    <record id="action_tcg_ocr_dashboard" model="ir.actions.act_url">
        <field name="name">Losse kaarten stock OCR Dashboard</field>
        <field name="url">/tcg/ocr</field>
        <field name="target">self</field>
    </record>

    <record id="action_tcg_ewallet_cards" model="ir.actions.act_window">
        <field name="name">eWallet Cards</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('program_type', '=', 'ewallet')]</field>
    </record>

    <!-- Single SuperTCG App Menu -->
    <menuitem id="menu_tcg_root"
              name="SuperTCG"
              sequence="15"
              web_icon="supertcg_products,static/description/icon.png"
              action="action_tcg_hub_dashboard"/>

    <!-- Sub-menus for direct access (optional, but useful) -->
    <menuitem id="menu_tcg_hub"
              name="Hub"
              parent="menu_tcg_root"
              action="action_tcg_hub_dashboard"
              sequence="10"/>

    <menuitem id="menu_tcg_aankoop"
              name="2dehands Aankopen"
              parent="menu_tcg_root"
              action="action_tcg_aankoop_dashboard"
              sequence="20"/>

    <menuitem id="menu_tcg_stock"
              name="Stock Toevoegen"
              parent="menu_tcg_root"
              action="action_tcg_card_form"
              sequence="30"/>

    <menuitem id="menu_tcg_consignment"
              name="Consignatie"
              parent="menu_tcg_root"
              action="action_tcg_consignment_dashboard"
              sequence="40"/>

    <menuitem id="menu_tcg_margin"
              name="Marge Analyse"
              parent="menu_tcg_root"
              action="action_tcg_margin_dashboard"
              sequence="50"/>

    <menuitem id="menu_tcg_ocr"
              name="OCR BETA"
              parent="menu_tcg_root"
              action="action_tcg_ocr_dashboard"
              sequence="60"/>

</odoo>
