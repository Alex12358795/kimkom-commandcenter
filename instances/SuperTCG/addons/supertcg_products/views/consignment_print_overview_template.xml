<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tcg_consignment_print_overview" name="TCG Consignment Print Overview">
        <t t-call="web.html_container">
            <t t-call="web.layout">
                <t t-set="head">
                    <style>
                        @page { size: A4; margin: 20mm 20mm 25mm 20mm; }
                        * { box-sizing: border-box; }
                        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; color: #333; margin: 0; padding: 0; }
                        .print-header { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 20px; border-bottom: 3px solid #5b8c5a; margin-top: 60px; margin-bottom: 28px; }
                        .print-logo { height: 44px; }
                        .print-header-right { text-align: right; }
                        .print-title { font-size: 24px; font-weight: 700; color: #5b8c5a; margin: 0 0 4px 0; }
                        .print-date { font-size: 12px; color: #999; margin-top: 6px; }
                        .company-info { margin-bottom: 28px; padding: 16px 20px; background: #f8faf8; border-radius: 8px; border-left: 4px solid #5b8c5a; }
                        .company-name { font-size: 16px; font-weight: 700; color: #5b8c5a; margin-bottom: 4px; }
                        .company-detail { font-size: 12px; color: #555; line-height: 1.6; }
                        .owner-info { margin-bottom: 28px; padding: 16px 20px; background: #fff; border-radius: 8px; border: 1px solid #ddd; border-left: 4px solid #333; }
                        .owner-name { font-size: 20px; font-weight: 700; color: #333; }
                        .owner-label { font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
                        table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 28px; }
                        thead th { background: #5b8c5a; color: white; padding: 11px 14px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
                        thead th:first-child { border-radius: 6px 0 0 0; }
                        thead th:last-child { border-radius: 0 6px 0 0; }
                        tbody td { padding: 10px 14px; border-bottom: 1px solid #eee; }
                        tbody tr:nth-child(even) { background: #fafafa; }
                        .text-right { text-align: right; }
                        .text-center { text-align: center; }
                        .total-row { background: #f0f5f0 !important; font-weight: 700; border-top: 2px solid #5b8c5a; }
                        .total-row td { padding: 13px 14px; }
                        .terms { margin-bottom: 32px; padding: 16px 20px; background: #f9f9f9; border-radius: 8px; border: 1px solid #e0e0e0; }
                        .terms-title { font-size: 13px; font-weight: 700; color: #333; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
                        .terms-text { font-size: 12px; color: #555; line-height: 1.6; }
                        .signatures { display: flex; gap: 40px; margin-top: 40px; margin-bottom: 20px; }
                        .signature-box { flex: 1; }
                        .signature-label { font-size: 12px; font-weight: 600; color: #333; margin-bottom: 8px; }
                        .signature-line { border-bottom: 1px solid #333; height: 50px; margin-bottom: 6px; }
                        .signature-sub { font-size: 11px; color: #999; }
                        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; font-size: 11px; color: #999; text-align: center; }
                        .no-items { text-align: center; padding: 40px; color: #999; font-size: 14px; }
                        @media print {
                            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                            .print-header { break-inside: avoid; }
                            .owner-info { break-inside: avoid; }
                            .company-info { break-inside: avoid; }
                            .terms { break-inside: avoid; }
                            .signatures { break-inside: avoid; }
                            table { break-inside: auto; }
                            tr { break-inside: avoid; break-after: auto; }
                            thead { display: table-header-group; }
                            tfoot { display: table-footer-group; }
                        }
                    </style>
                </t>

                <div class="print-header">
                    <div>
                        <img src="/supertcg_products/static/src/img/header_logo.png" class="print-logo" alt="SuperTCG"/>
                    </div>
                    <div class="print-header-right">
                        <h1 class="print-title">Consignment Overview</h1>
                        <div class="print-date">Generated: <t t-esc="today"/></div>
                    </div>
                </div>

                <div class="company-info">
                    <div class="company-name"><t t-esc="company['name']"/></div>
                    <div class="company-detail">
                        <t t-if="company['street']"><t t-esc="company['street']"/></t>
                        <t t-if="company['zip'] or company['city']"> | <t t-esc="company['zip']"/> <t t-esc="company['city']"/></t>
                        <t t-if="company['country']"> | <t t-esc="company['country']"/></t>
                        <t t-if="company['vat']"><br/>BTW: <t t-esc="company['vat']"/></t>
                        <t t-if="company['phone']"><br/>Tel: <t t-esc="company['phone']"/></t>
                        <t t-if="company['email']"> | <t t-esc="company['email']"/></t>
                        <t t-if="company['website']"><br/><t t-esc="company['website']"/></t>
                    </div>
                </div>

                <div class="owner-info">
                    <div class="owner-label">Owner</div>
                    <div class="owner-name"><t t-esc="partner.name"/></div>
                </div>

                <t t-if="lines">
                    <table>
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th class="text-center">Received</th>
                                <th class="text-center">In Stock</th>
                                <th>Stock Location</th>
                                <th class="text-right">Cost Price</th>
                                <th class="text-right">Total Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <tr>
                                    <td><t t-esc="line['product_name']"/></td>
                                    <td><t t-esc="line['category']"/></td>
                                    <td class="text-center"><t t-esc="line['received_qty']"/></td>
                                    <td class="text-center"><t t-esc="line['in_stock_qty']"/></td>
                                    <td><t t-esc="line['location']"/></td>
                                    <td class="text-right">&#x20AC;<t t-esc="'%.2f' % line['cost_price']"/></td>
                                    <td class="text-right">&#x20AC;<t t-esc="'%.2f' % line['total_value']"/></td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td colspan="5">Total</td>
                                <td></td>
                                <td class="text-right">&#x20AC;<t t-esc="'%.2f' % total_value"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <div class="no-items">No items currently in stock for this owner.</div>
                </t>

                <div class="terms">
                    <div class="terms-title">Consignatievoorwaarden</div>
                    <div class="terms-text">
                        Deze goederen zijn in consignatie gegeven aan SuperTCG. Bij verkoop wordt een commissie van 15% op de afgesproken verkoopwaarde ingehouden. De eigenaar behoudt het recht om deze voorraad op elk gewenst moment terug te nemen.
                    </div>
                </div>

                <div class="signatures">
                    <div class="signature-box">
                        <div class="signature-label">Handtekening eigenaar (Owner)</div>
                        <div class="signature-line"></div>
                        <div class="signature-sub">Naam: ___________________________</div>
                    </div>
                    <div class="signature-box">
                        <div class="signature-label">Handtekening SuperTCG</div>
                        <div class="signature-line"></div>
                        <div class="signature-sub">Naam: ___________________________</div>
                    </div>
                </div>

                <div class="footer">
                    SuperTCG &#8212; Consignment Overview &#8212; <t t-esc="today"/>
                </div>

                <script>
                    window.onload = function() { window.print(); };
                </script>
            </t>
        </t>
    </template>

</odoo>
