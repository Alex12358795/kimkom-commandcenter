<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tcg_intake_wizard_form" model="ir.ui.view">
        <field name="name">tcg.intake.wizard.form</field>
        <field name="model">tcg.intake.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="intake_type" readonly="1"/>
                        <field name="partner_id"
                               placeholder="Search customer/supplier..."/>
                        <field name="employee_id"
                               placeholder="Select employee (optional)..."/>
                        <field name="picking_type_id"
                               placeholder="Select incoming operation type..."/>
                        <field name="product_qty"
                               invisible="intake_type != 'buy_in'"/>
                        <field name="price_unit"
                               invisible="intake_type != 'buy_in'"/>
                        <field name="consignment_enabled" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_start_intake"
                            type="object"
                            string="Start Intake"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tcg_intake_wizard" model="ir.actions.act_window">
        <field name="name">New Buy-in</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tcg.intake.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_intake_type': 'buy_in'}</field>
    </record>

    <record id="action_tcg_intake_wizard_consignment" model="ir.actions.act_window">
        <field name="name">New Consignment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tcg.intake.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_intake_type': 'consignment'}</field>
    </record>

</odoo>
