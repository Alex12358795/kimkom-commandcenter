<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Landing Page: All Locations -->
        <template id="events_locations_page" name="SuperTCG Events - Locations">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <section class="s_cover pb40 pt56" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                        <div class="container">
                            <div class="row s_nb_column_fixed">
                                <div class="col-lg-12 text-center">
                                    <h1 class="display-5 text-white fw-bold mb-3">
                                        SuperTCG Events
                                    </h1>
                                    <p class="lead text-white-50 fs-4 mb-0" style="opacity: 0.9;">
                                        Onze Locaties
                                    </p>
                                    <div class="mt-3" style="width: 60px; height: 3px; background: #e94560; margin: 0 auto; border-radius: 2px;"></div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="s_text_block pt32 pb24">
                        <div class="container">
                            <div class="row justify-content-center">
                                <t t-foreach="locations" t-as="location_key">
                                    <t t-set="location" t-value="locations[location_key]"/>
                                    <div class="col-lg-3 col-md-6 mb-4">
                                        <a t-attf-href="/events/location/#{location['address_slug']}" class="text-decoration-none">
                                            <div class="card h-100 shadow-sm border-0 hover-shadow">
                                                <div class="card-img-top overflow-hidden" style="height: 220px;">
                                                    <t t-if="'leuven' in location['name'].lower()">
                                                        <img src="/supertcg_events/static/src/img/leuven.webp" class="w-100 h-100" style="object-fit: cover;" alt="Leuven"/>
                                                    </t>
                                                    <t t-elif="'mechelen' in location['name'].lower()">
                                                        <img src="/supertcg_events/static/src/img/mechelen.webp" class="w-100 h-100" style="object-fit: cover;" alt="Mechelen"/>
                                                    </t>
                                                    <t t-elif="'hasselt' in location['name'].lower()">
                                                        <img src="/supertcg_events/static/src/img/hasselt.webp" class="w-100 h-100" style="object-fit: cover;" alt="Hasselt"/>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="bg-o-color-1 text-center h-100 d-flex align-items-center justify-content-center">
                                                            <i class="fa fa-store fa-4x text-white"/>
                                                        </div>
                                                    </t>
                                                </div>
                                                <div class="card-body text-center p-4">
                                                    <h4 class="card-title fw-bold text-o-color-1 mb-2">
                                                        <t t-esc="location['name']"/>
                                                    </h4>
                                                    <p class="text-muted mb-3">
                                                        <t t-if="location['address_street']">
                                                            <t t-esc="location['address_street']"/><br/>
                                                            <t t-esc="location['address_zip']"/> <t t-esc="location['address_city']"/>
                                                        </t>
                                                    </p>
                                                    <span class="badge bg-o-color-1 fs-6 px-3 py-2">
                                                        <i class="fa fa-calendar me-2"/>
                                                        <t t-esc="location['event_count']"/> evenementen
                                                    </span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <!-- Location Events Page -->
        <template id="events_by_location_page" name="SuperTCG Events - Location Detail">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <section class="s_cover pb32 pt40" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
                        <div class="container">
                            <div class="row s_nb_column_fixed">
                                <div class="col-lg-12 text-center">
                                    <h1 class="display-6 text-white fw-bold mb-2">
                                        <t t-esc="location['name']"/>
                                    </h1>
                                    <p class="text-white-50 fs-5 mb-3" style="opacity: 0.9;">
                                        <i class="fa fa-map-marker me-2"/>
                                        <t t-esc="location['street']"/>, <t t-esc="location['zip']"/> <t t-esc="location['city']"/>
                                    </p>
                                    <a href="/events/locations" class="btn btn-outline-light btn-sm mt-2">
                                        <i class="fa fa-arrow-left me-2"/>Terug naar locaties
                                    </a>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="s_text_block pt48 pb24">
                        <div class="container">
                            <div class="row mb-5">
                                <div class="col-lg-12 text-center">
                                    <h2 class="display-6 fw-bold mb-4">Aankomende <span class="text-o-color-1">Evenementen</span></h2>
                                </div>
                            </div>
                            
                            <!-- Use Odoo's default event grid -->
                            <div class="row">
                                <t t-foreach="events" t-as="event">
                                    <div class="col-lg-4 col-md-6 mb-4">
                                        <div class="card h-100 shadow-sm border-0">
                                            <img t-att-src="'/web/image/event.event/' + str(event.id) + '/image_1024'" 
                                                 class="card-img-top" 
                                                 style="height: 180px; object-fit: cover;" 
                                                 alt="Event Image"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"/>
                                            <div class="card-img-top bg-o-color-1 text-center" style="height: 180px; display: none;">
                                                <i class="fa fa-gamepad text-white fa-3x" style="line-height: 180px;"/>
                                            </div>
                                            <div class="card-body p-4">
                                                <h5 class="card-title fw-bold mb-2"><t t-esc="event.name"/></h5>
                                                <p class="text-muted mb-1">
                                                    <i class="fa fa-calendar me-2 text-o-color-1"/>
                                                    <t t-esc="event.date_begin.strftime('%A %d %B %Y')"/>
                                                </p>
                                                <p class="card-text text-muted mb-2">
                                                    <i class="fa fa-clock-o me-2 text-o-color-1"/>
                                                    <t t-esc="event.date_begin.strftime('%H:%M')"/> - <t t-esc="event.date_end.strftime('%H:%M')"/>
                                                </p>
                                                
                                                <!-- Seat Availability -->
                                                <div class="mb-3">
                                                    <t t-if="event.seats_limited">
                                                        <t t-if="event.event_registrations_sold_out">
                                                            <span class="badge bg-danger">
                                                                <i class="fa fa-users me-1"/> <t t-esc="event.seats_reserved"/>/<t t-esc="event.seats_max"/> - Wachtlijst
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-success">
                                                                <i class="fa fa-users me-1"/> <t t-esc="event.seats_reserved"/>/<t t-esc="event.seats_max"/> Plekken beschikbaar
                                                            </span>
                                                        </t>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-info">
                                                            <i class="fa fa-users me-1"/> Onbeperkte plaatsen
                                                        </span>
                                                    </t>
                                                </div>
                                                
                                                <t t-if="event.event_registrations_sold_out">
                                                    <a t-attf-href="/event/{{ slug(event) }}" class="btn btn-warning w-100">
                                                        <i class="fa fa-clock-o me-2"/>Wachtlijst
                                                    </a>
                                                </t>
                                                <t t-else="">
                                                    <a t-attf-href="/event/{{ slug(event) }}" class="btn btn-outline-primary w-100">
                                                        <i class="fa fa-info-circle me-2"/>Details &amp; Inschrijven
                                                    </a>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            
                            <t t-if="not events">
                                <div class="row">
                                    <div class="col-lg-12 text-center py-5">
                                        <i class="fa fa-calendar-o fa-4x text-muted mb-3"/>
                                        <h3 class="text-muted">Geen evenementen gepland</h3>
                                        <p class="lead">Kom later terug voor nieuwe evenementen!</p>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </section>
                </div>
            </t>
        </template>
    </data>
</odoo>
