    <record id="action_report_buylist" model="ir.actions.report">
        <field name="name">Buylist PDF</field>
        <field name="model">supertcg.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">supertcg_scanner.report_buylist</field>
