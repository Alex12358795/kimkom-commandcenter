<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Multi-Company Record Rules                                    -->
    <!-- Every internal user sees batches; rules filter by company.   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Batch: users see their company's batches -->
    <record id="rule_supertcg_batch_multi_company" model="ir.rule">
        <field name="name">SuperTCG Batch: Multi-Company</field>
        <field name="model_id" ref="model_supertcg_batch"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

    <!-- Batch Card: users see cards from their company's batches -->
    <record id="rule_supertcg_batch_card_multi_company" model="ir.rule">
        <field name="name">SuperTCG Batch Card: Multi-Company</field>
        <field name="model_id" ref="model_supertcg_batch_card"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

    <!-- Scanner Device: users see their company's scanner devices -->
    <record id="rule_supertcg_scanner_device_multi_company" model="ir.rule">
        <field name="name">SuperTCG Scanner Device: Multi-Company</field>
        <field name="model_id" ref="model_supertcg_scanner_device"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="global" eval="True"/>
    </record>

</odoo>
