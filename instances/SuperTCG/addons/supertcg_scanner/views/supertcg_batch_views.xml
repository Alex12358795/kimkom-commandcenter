<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_supertcg_batch" model="ir.actions.act_window">
        <field name="name">Scanner Batches</field>
        <field name="res_model">supertcg.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_supertcg_batch_card" model="ir.actions.act_window">
        <field name="name">Batch Cards</field>
        <field name="res_model">supertcg.batch.card</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Actions referenced by views below — must be defined BEFORE they're referenced -->
    <record id="action_supertcg_scanner_device" model="ir.actions.act_window">
        <field name="name">Scanner Devices</field>
        <field name="res_model">supertcg.scanner.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_supertcg_pricing_config" model="ir.actions.act_window">
        <field name="name">Pricing Configuration</field>
        <field name="res_model">supertcg.pricing.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Server action for list view "Pull from Pi" button -->
    <record id="action_pull_from_pi_server" model="ir.actions.server">
        <field name="name">Pull from Pi</field>
        <field name="model_id" ref="model_supertcg_batch"/>
        <field name="state">code</field>
        <field name="code">
action = env['supertcg.batch'].browse([record.id for record in records if records]).action_pull_from_pi() if records else env['supertcg.batch'].action_pull_from_pi()
        </field>
    </record>

    <record id="view_supertcg_batch_list" model="ir.ui.view">
        <field name="name">supertcg.batch.list</field>
        <field name="model">supertcg.batch</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-success="state == 'processed'" create="0">
                <header>
                    <button name="%(supertcg_scanner.action_pull_from_pi_server)d" type="action" string="Pull from Pi" class="oe_highlight" display="always"/>
                    <button name="%(base_setup.action_general_configuration)d" type="action" string="Settings" class="btn btn-secondary"/>
                    <button name="%(supertcg_scanner.action_supertcg_scanner_device)d" type="action" string="Devices" class="btn btn-secondary"/>
                    <button name="%(supertcg_scanner.action_supertcg_pricing_config)d" type="action" string="Pricing" class="btn btn-secondary"/>
                </header>
                <field name="batch_name"/>
                <field name="scanner_device_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="card_count"/>
                <field name="included_card_count"/>
                <field name="total_purchase_price" optional="show"/>
                <field name="state"/>
                <field name="scanned_at"/>
                <field name="device_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_supertcg_batch_form" model="ir.ui.view">
        <field name="name">supertcg.batch.form</field>
        <field name="model">supertcg.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pull_from_pi" type="object" string="Pull from Pi" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_add_to_inventory" type="object" string="Add to Inventory" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_generate_buylist_pdf" type="object" string="Print Buylist PDF" invisible="state != 'draft'"/>
                    <button name="action_print_labels" type="object" string="Print Labels" invisible="state != 'processed'" class="oe_highlight"/>
                    <button name="action_fetch_images_from_cdn" type="object" string="Fetch Images" invisible="state == 'draft'" class="btn btn-secondary"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" class="btn btn-warning"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not has_new_set_cards">
                        <strong>Warning:</strong> This batch contains cards from recently released sets. Consider the 3-week new-set policy before purchasing.
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_all_cards" type="object" class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">All Cards</span>
                            </div>
                        </button>
                        <button name="action_open_label_mappings" type="object" class="oe_stat_button" icon="fa-plug">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Devices</span>
                            </div>
                        </button>
                        <button name="action_open_pricing" type="object" class="oe_stat_button" icon="fa-calculator">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pricing</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="batch_name"/></h1>
                    </div>
                    <group>
                        <group string="Batch">
                            <field name="batch_id"/>
                            <field name="product_category_id"/>
                            <field name="scanner_device_id"/>
                            <field name="device_id" optional="show"/>
                            <field name="card_count"/>
                            <field name="included_card_count"/>
                            <field name="has_new_set_cards" invisible="1"/>
                            <field name="total_market_price"/>
                            <field name="total_purchase_price"/>
                            <field name="total_credit_purchase_price"/>
                        </group>
                        <group string="Inventory">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="company_id" string="Store"/>
                            <field name="scanned_at"/>
                        </group>
                        <group string="Product">
                            <field name="website_category_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cards">
                            <field name="card_line_ids">
                                <list editable="bottom">
                                    <field name="is_included" widget="boolean_toggle"/>
                                    <field name="image_base64" widget="image" options="{'size': [64, 64]}" optional="show"/>
                                    <field name="game_name" optional="show"/>
                                    <field name="card_name"/>
                                    <field name="set_name" optional="show"/>
                                    <field name="card_number" optional="show"/>
                                    <field name="condition" optional="show"/>
                                    <field name="card_category" optional="show"/>
                                    <field name="is_new_set" optional="hide"/>
                                    <field name="remark" optional="show"/>
                                    <field name="purchase_basis" optional="hide"/>
                                    <field name="price_market" optional="show"/>
                                    <field name="purchase_price" optional="show"/>
                                    <field name="purchase_breakdown" optional="show"/>
                                    <field name="credit_purchase_price" optional="show"/>
                                    <field name="sales_price" optional="show"/>
                                    <field name="sales_breakdown" optional="show"/>
                                    <field name="product_product_id" optional="show"/>
                                    <button name="action_open_product" type="object" string="Open" icon="fa-external-link" invisible="not product_product_id"/>
                                    <field name="rarity" optional="show"/>
                                    <field name="printing" optional="show"/>
                                    <field name="language" optional="show"/>
                                    <field name="foil" optional="show"/>
                                    <field name="is_reverse_holo" optional="show"/>
                                    <field name="confidence" optional="show"/>
                                    <field name="price_low" optional="hide"/>
                                    <field name="price_mid" optional="hide"/>
                                    <field name="price_high" optional="hide"/>
                                    <field name="price_direct_low" optional="hide"/>
                                    <field name="possible_mismatch" optional="hide"/>
                                    <field name="status" optional="hide"/>
                                    <field name="external_product_id" optional="hide"/>
                                    <field name="ext_card_type" optional="hide"/>
                                    <field name="ext_hp" optional="hide"/>
                                    <field name="ext_stage" optional="hide"/>
                                    <field name="ext_attack_1" optional="hide"/>
                                    <field name="ext_attack_2" optional="hide"/>
                                    <field name="ext_weakness" optional="hide"/>
                                    <field name="ext_resistance" optional="hide"/>
                                    <field name="ext_retreatcost" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Processing Logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date" width="140"/>
                                    <field name="level" widget="badge" decoration-success="level == 'success'" decoration-info="level == 'info'" decoration-warning="level == 'warning'" decoration-danger="level == 'error'"/>
                                    <field name="stage" optional="show"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_supertcg_batch_search" model="ir.ui.view">
        <field name="name">supertcg.batch.search</field>
        <field name="model">supertcg.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_name"/>
                <field name="batch_id"/>
                <field name="scanner_device_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="device_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_scanner" string="Scanner" context="{'group_by': 'scanner_device_id'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'company_id'}"/>
                </group>
                <searchpanel>
                    <field name="scanner_device_id" string="Scanner" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Batch Card List View -->
    <record id="view_supertcg_batch_card_list" model="ir.ui.view">
        <field name="name">supertcg.batch.card.list</field>
        <field name="model">supertcg.batch.card</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="is_included" widget="boolean_toggle"/>
                <field name="image_base64" widget="image" options="{'size': [64, 64]}" optional="show"/>
                <field name="game_name" optional="show"/>
                <field name="card_name"/>
                <field name="set_name" optional="show"/>
                <field name="card_number" optional="show"/>
                <field name="condition" optional="show"/>
                <field name="card_category" optional="show"/>
                <field name="is_new_set" optional="hide"/>
                <field name="remark" optional="show"/>
                <field name="purchase_basis" optional="hide"/>
                <field name="price_market" optional="show"/>
                <field name="purchase_price" optional="show"/>
                <field name="credit_purchase_price" optional="show"/>
                <field name="sales_price" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="batch_id" optional="show"/>
                <field name="unique_barcode" optional="show"/>
                <field name="product_product_id" optional="show"/>
                <button name="action_open_product" type="object" string="Open" icon="fa-external-link" invisible="not product_product_id"/>
            </list>
        </field>
    </record>

    <!-- Batch Card Form View -->
    <record id="view_supertcg_batch_card_form" model="ir.ui.view">
        <field name="name">supertcg.batch.card.form</field>
        <field name="model">supertcg.batch.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_supertcg_batch)d" type="action" string="Open Batch" icon="fa-folder-open" context="{'search_default_batch_id': batch_id}"/>
                        <button name="action_open_product" type="object" string="Open Product" icon="fa-external-link" invisible="not product_product_id"/>
                    </div>
                    <field name="image_base64" widget="image" class="oe_avatar" options="{'preview_image': 'image_base64', 'size': [128, 128]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="card_name" placeholder="Card Name"/>
                        </h1>
                        <h3><field name="clean_name" readonly="1"/></h3>
                    </div>
                    <group string="Source">
                        <field name="batch_id"/>
                        <field name="company_id" string="Store"/>
                        <field name="scanner_alias"/>
                        <field name="sequence"/>
                        <field name="timestamp"/>
                    </group>
                    <group>
                        <group string="Identification">
                            <field name="game_name"/>
                            <field name="set_name"/>
                            <field name="set_code"/>
                            <field name="card_number"/>
                            <field name="external_product_id"/>
                            <field name="unique_barcode"/>
                            <field name="handle"/>
                            <field name="group_id"/>
                            <field name="category_id"/>
                        </group>
                        <group string="Attributes">
                            <field name="rarity"/>
                            <field name="printing"/>
                            <field name="edition"/>
                            <field name="language"/>
                            <field name="published_year"/>
                            <field name="foil"/>
                            <field name="is_reverse_holo"/>
                        </group>
                    </group>
                    <group string="Category &amp; Condition">
                        <group>
                            <field name="card_category"/>
                            <field name="condition"/>
                            <field name="is_wotc"/>
                            <field name="is_new_set"/>
                        </group>
                        <group>
                            <field name="remark"/>
                            <field name="status"/>
                            <field name="is_error_card"/>
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="purchase_basis"/>
                            <field name="price_low"/>
                            <field name="price_mid"/>
                            <field name="price_high"/>
                        </group>
                        <group>
                            <field name="price_market"/>
                            <field name="price_direct_low"/>
                        </group>
                        <group string="SuperTCG Pricing">
                            <field name="purchase_price"/>
                            <field name="credit_purchase_price"/>
                            <field name="sales_price"/>
                        </group>
                    </group>
                    <group string="Scan &amp; Quality">
                        <group>
                            <field name="scanner_alias"/>
                            <field name="sequence"/>
                            <field name="timestamp"/>
                            <field name="confidence"/>
                            <field name="possible_mismatch"/>
                            <field name="mismatch_reason"/>
                        </group>
                        <group>
                            <field name="confidence"/>
                            <field name="possible_mismatch"/>
                            <field name="mismatch_reason"/>
                            <field name="is_error_card"/>
                        </group>
                    </group>
                    <group string="Images">
                        <field name="cdn_image_url" widget="url"/>
                        <field name="cdn_scan_image_url" widget="url"/>
                    </group>
                    <group string="Extended Data">
                        <field name="ext_data"/>
                    </group>
                    <group string="Processing">
                        <field name="is_included"/>
                        <field name="product_product_id"/>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Batch Card Search View -->
    <record id="view_supertcg_batch_card_search" model="ir.ui.view">
        <field name="name">supertcg.batch.card.search</field>
        <field name="model">supertcg.batch.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="card_name"/>
                <field name="game_name"/>
                <field name="set_name"/>
                <field name="set_code"/>
                <field name="external_product_id"/>
                <field name="batch_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="included" string="Included" domain="[('is_included', '=', True)]"/>
                <filter name="excluded" string="Excluded" domain="[('is_included', '=', False)]"/>
                <filter name="mismatch" string="Possible Mismatch" domain="[('possible_mismatch', '=', True)]"/>
                <filter name="has_product" string="In Inventory" domain="[('product_product_id', '!=', False)]"/>
                <filter name="no_product" string="Not in Inventory" domain="[('product_product_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_game" string="Game" context="{'group_by': 'game_name'}"/>
                    <filter name="group_by_set" string="Set" context="{'group_by': 'set_name'}"/>
                    <filter name="group_by_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_supertcg_scanner_app"
              name="Scanner"
              sequence="100"
              web_icon="supertcg_scanner,static/description/icon.svg"/>

    <menuitem id="menu_supertcg_scanner_batches"
              name="Batches"
              parent="menu_supertcg_scanner_app"
              action="action_supertcg_batch"
              sequence="10"/>

    <menuitem id="menu_supertcg_scanner_cards"
              name="All Cards"
              parent="menu_supertcg_scanner_app"
              action="action_supertcg_batch_card"
              sequence="20"/>

    <menuitem id="menu_supertcg_scanner_devices"
              name="Devices"
              parent="menu_supertcg_scanner_app"
              action="action_supertcg_scanner_device"
              sequence="30"/>

    <menuitem id="menu_supertcg_scanner_pricing"
              name="Pricing"
              parent="menu_supertcg_scanner_app"
              action="action_supertcg_pricing_config"
              sequence="40"/>

    <record id="view_supertcg_scanner_device_list" model="ir.ui.view">
        <field name="name">supertcg.scanner.device.list</field>
        <field name="model">supertcg.scanner.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="batch_count" optional="show"/>
                <field name="total_cards_scanned" optional="show"/>
                <field name="last_scan_date" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_supertcg_scanner_device_form" model="ir.ui.view">
        <field name="name">supertcg.scanner.device.form</field>
        <field name="model">supertcg.scanner.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., Hasselt Store Scanner"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scanner">
                            <field name="api_key" placeholder="Required: unique API key for this scanner"/>
                            <field name="pi_url" placeholder="https://supertcg-pi.bore.digital/api/batches"/>
                            <field name="company_id" string="Store"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Inventory Location">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                        </group>

                    </group>
                    <field name="notes" placeholder="Notes about this mapping..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_supertcg_pricing_config_list" model="ir.ui.view">
        <field name="name">supertcg.pricing.config.list</field>
        <field name="model">supertcg.pricing.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="purchase_nm_ex_pct"/>
                <field name="purchase_other_pct"/>
                <field name="sales_markup_pct"/>
                <field name="round_to"/>
            </list>
        </field>
    </record>

    <record id="view_supertcg_pricing_config_form" model="ir.ui.view">
        <field name="name">supertcg.pricing.config.form</field>
        <field name="model">supertcg.pricing.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Pricing Formula Configuration</h1>
                    </div>
                    <group>
                        <group string="Purchase Pricing (% of Price Low)">
                            <field name="purchase_nm_ex_pct"/>
                            <field name="purchase_other_pct"/>
                            <field name="purchase_pl_po_pct"/>
                            <field name="purchase_credit_premium"/>
                            <field name="purchase_min_price"/>
                        </group>
                        <group string="Sales Pricing">
                            <field name="sales_markup_pct"/>
                            <field name="sales_min_price"/>
                            <field name="round_to"/>
                        </group>
                    </group>
                    <group string="Category Floor Prices (Sales)">
                        <group>
                            <field name="floor_common_uncommon"/>
                            <field name="floor_holo"/>
                            <field name="floor_reverse_holo"/>
                            <field name="floor_ex_en"/>
                            <field name="floor_ex_jp"/>
                            <field name="floor_v_en"/>
                            <field name="floor_v_jp"/>
                            <field name="floor_vmax"/>
                        </group>
                        <group>
                            <field name="floor_full_art"/>
                            <field name="floor_alternate_art"/>
                            <field name="floor_wotc_common_nm"/>
                            <field name="floor_wotc_common_below_nm"/>
                        </group>
                    </group>
                    <group string="Slab Pricing (Future Use)">
                        <group>
                            <field name="slab_high_grade_pct"/>
                            <field name="slab_low_grade_pct"/>
                        </group>
                        <group>
                            <field name="slab_tier1_pct"/>
                            <field name="slab_tier2_pct"/>
                            <field name="slab_tier3_pct"/>
                        </group>
                    </group>
                    <group string="Advanced">
                        <group>
                            <field name="wotc_set_codes"/>
                            <field name="new_set_warning_days"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <div style="margin-top: 16px; padding: 12px; background: #f8f9fa; border-radius: 6px;">
                        <p><strong>How it works:</strong></p>
                        <p>• <strong>Purchase (Cash/Wire Transfer)</strong> = round(Price Low × Condition %, Round To), min = Min Purchase Price</p>
                        <p>• <strong>Purchase (Store Credit)</strong> = round(Price Low × (Condition % + Store Credit Premium), Round To)</p>
                        <p>• <strong>Sales</strong> = max(round(Price Market × Sales Markup %, Round To), Category Floor), min = Min Sales Price</p>
                        <p>These prices are calculated automatically on every card and used when creating products or printing buylist PDFs.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_supertcg_scanner_root" name="Scanner" sequence="50" parent="stock.menu_stock_root"/>
    <menuitem id="menu_supertcg_batch" name="Batches" action="action_supertcg_batch" parent="menu_supertcg_scanner_root" sequence="10"/>
    <menuitem id="menu_supertcg_scanner_device" name="Devices" action="action_supertcg_scanner_device" parent="menu_supertcg_scanner_root" sequence="20"/>
    <menuitem id="menu_supertcg_pricing_config" name="Pricing" action="action_supertcg_pricing_config" parent="menu_supertcg_scanner_root" sequence="30"/>

</odoo>
