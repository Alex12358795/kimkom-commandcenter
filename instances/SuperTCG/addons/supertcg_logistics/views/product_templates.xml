<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="product_warehouse_availability" inherit_id="website_sale_stock.website_sale_stock_product">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-if="product._get_warehouse_availability()">
                <t t-set="wh_avail" t-value="product._get_warehouse_availability()"/>
                <t t-set="pickup_max" t-value="max([int(info['qty']) for info in wh_avail]) if wh_avail else 0"/>
                <div class="alert alert-success mt-2 o_not_editable">
                    <i class="fa fa-store me-2"/>
                    <strong>Available in:</strong>
                    <t t-foreach="wh_avail" t-as="wh_info">
                        <span t-esc="wh_info['warehouse'].name"/>
                        (<span t-esc="int(wh_info['qty'])"/>)
                        <t t-if="not wh_info_last">, </t>
                    </t>
                    <br/>
                    <small class="text-muted">
                        <i class="fa fa-info-circle me-1"/>
                        Max for store pickup: <strong t-esc="pickup_max"/> units
                        | Total for delivery: <strong t-esc="int(product._get_website_max_qty())"/> units
                    </small>
                </div>
            </t>
        </xpath>
    </template>

    <template id="product_quantity_max" inherit_id="website_sale.product_quantity">
        <xpath expr="//input[@name='add_qty']" position="attributes">
            <attribute name="t-att-data-max">product._get_website_max_qty()</attribute>
        </xpath>
    </template>
</odoo>
