<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add data-max to cart page quantity inputs -->
    <template id="cart_quantity_max" inherit_id="website_sale.cart_lines">
        <xpath expr="//div[@name='website_sale_cart_line_quantity']//input[@type='text']" position="attributes">
            <attribute name="t-att-data-max">line.product_id._get_website_max_qty()</attribute>
        </xpath>
    </template>
</odoo>
